# Local ClickHouse credentials. Change the password for shared environments.
CLICKHOUSE_HOST=localhost
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
CLICKHOUSE_DATABASE=otel
CLICKHOUSE_USER=agentic
CLICKHOUSE_PASSWORD=agentic-dev

# Tags attached to Claude Code telemetry.
AGENTIC_DEV_EXPERIMENT_ID=local
AGENTIC_DEV_COHORT=engineering

# Leave detailed content capture disabled unless a lab explicitly requires it.
OTEL_LOG_USER_PROMPTS=0
OTEL_LOG_ASSISTANT_RESPONSES=0
OTEL_LOG_TOOL_DETAILS=0
OTEL_LOG_TOOL_CONTENT=0

# Enhanced Claude Code traces are beta. Set to 1 to opt in.
CLAUDE_CODE_ENABLE_TRACES=0
